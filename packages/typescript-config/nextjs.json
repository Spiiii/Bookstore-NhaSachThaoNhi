{
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "react", "react-dom"],
    "plugins": [{ "name": "next" }]
  }
}
