PORT=3001
DATABASE_URL=postgresql://bookstore_runtime:replace-me@localhost:5432/bookstore

JWT_ACCESS_SECRET=replace-with-canonical-base64-for-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-canonical-base64-for-32-random-bytes
JWT_ISSUER=bookstore-api
JWT_ACCESS_AUDIENCE=bookstore-web-access
JWT_REFRESH_AUDIENCE=bookstore-web-refresh

AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_PATH=/auth
AUTH_COOKIE_SAME_SITE=strict
TRUSTED_PROXIES=
SWAGGER_ENABLED=false

PASSWORD_ARGON2_MEMORY_COST=65536
PASSWORD_ARGON2_TIME_COST=3
PASSWORD_ARGON2_PARALLELISM=1

STORAGE_LOCAL_ROOT=/var/lib/bookstore/uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_PIXELS=16000000
UPLOAD_MAX_CONCURRENT=2
BANNER_PLACEMENTS=home-hero
