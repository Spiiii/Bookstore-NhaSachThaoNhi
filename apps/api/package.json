{
  "name": "@bookstore/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test:unit": "node test/run-unit-tests.mjs",
    "test:brands": "node test/run-brands-tests.mjs",
    "test:categories": "node test/run-categories-tests.mjs",
    "test:catalog": "node test/run-catalog-tests.mjs",
    "test:admin": "node test/run-admin-tests.mjs",
    "test:admin:postgres": "node test/run-admin-tests.mjs --postgres",
    "test:invariants:postgres": "node test/run-admin-tests.mjs --postgres",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm typecheck:operations && pnpm typecheck:tooling",
    "typecheck:operations": "tsc -p tsconfig.operations.json --noEmit",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:operations": "tsc -p tsconfig.operations.json",
    "build:tooling": "tsc -p tsconfig.tooling.json",
    "test:news": "node test/run-news-tests.mjs",
    "test:banners": "node test/run-banners-tests.mjs",
    "test:uploads": "node test/run-uploads-tests.mjs",
    "cleanup:media": "node dist-operations/operations/cleanup-media.js",
    "test:content-review": "node test/run-content-review-tests.mjs",
    "test:content:postgres": "node test/run-content-review-tests.mjs --postgres",
    "test:openapi": "node test/run-openapi-tests.mjs"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/swagger": "7.4.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "dotenv": "17.4.2",
    "multer": "2.3.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@bookstore/eslint-config": "workspace:*",
    "@bookstore/typescript-config": "workspace:*",
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.22",
    "@types/express": "4.17.23",
    "@types/jest": "29.5.14",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.0",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.15.6",
    "eslint": "9.39.4",
    "jest": "29.7.0",
    "prisma": "7.10.0",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  }
}
