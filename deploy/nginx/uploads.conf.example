# Include limit zones in nginx http{}, and the location in the API server{}.
# Adjust the route if the API is mounted under /api. TLS/server setup is deployment-owned.
limit_req_zone $binary_remote_addr zone=upload_rate:10m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=upload_connections:10m;

server {
    listen 8080;
    location = /admin/uploads {
        limit_req zone=upload_rate burst=2 nodelay;
        limit_req_status 429;
        limit_conn upload_connections 2;
        limit_conn_status 429;
        # Multipart overhead above the API default 5 MiB file maximum.
        client_max_body_size 6m;
        client_body_timeout 15s;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_request_buffering off;
        proxy_pass http://api:3000;
    }
}
